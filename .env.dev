###> symfony/mailer ###
# Pour tester l'envoi d'emails en développement, on peut utiliser un outil comme Mailpit
# docker run -d -p 8025:8025 -p 1025:1025 axllent/mailpit
# Le port 8025 est l'interface web, pour lire les emails, accessible sur http://localhost:8025
# Le port 1025 est le serveur SMTP (pour l'envoi depuis Symfony).
MAILER_DSN=smtp://127.0.0.1:1025
